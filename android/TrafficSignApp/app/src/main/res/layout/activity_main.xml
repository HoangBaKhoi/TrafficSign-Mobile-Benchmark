<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Màn hình camera realtime, ẩn cho tới khi bấm BẮT ĐẦU ở màn menu -->
    <FrameLayout
        android:id="@+id/cameraGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Camera preview -->
        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Bounding-box overlay -->
        <com.example.trafficsignapp.OverlayView
            android:id="@+id/overlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Thông tin realtime -->
        <TextView
            android:id="@+id/tvFrameInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"
            android:background="@drawable/bg_info_panel"
            android:elevation="4dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:padding="12dp"
            android:text="Đang khởi động..."
            android:textColor="@color/white"
            android:textSize="14sp" />

        <!-- Đổi model + delegate dùng cho camera realtime -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectModel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="28dp"
            android:elevation="6dp"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:text="⚙  ĐỔI CHẾ ĐỘ"
            android:textColor="@color/color_background_dark"
            android:textSize="15sp"
            app:backgroundTint="@color/color_accent"
            app:cornerRadius="28dp" />

    </FrameLayout>

    <!-- Màn hình menu, hiện đầu tiên khi mở app -->
    <LinearLayout
        android:id="@+id/menuGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_background_dark"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.02"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Nhận diện biển báo giao thông\nthời gian thực bằng YOLO11 + LiteRT"
            android:textColor="@color/color_text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:paddingHorizontal="40dp"
            android:paddingVertical="12dp"
            android:text="BẮT ĐẦU"
            android:textSize="16sp"
            app:cornerRadius="28dp" />

    </LinearLayout>

</FrameLayout>
